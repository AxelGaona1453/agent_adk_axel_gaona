# Copiá este archivo como .env (en esta misma carpeta) y ajustá los valores.
# El archivo .env NO se sube al repositorio.

# Modelo que usa el agente vía LiteLLM. Por defecto Ollama local.
# Tiene que ser un modelo con soporte de herramientas (tool calling),
# por ejemplo: ollama_chat/llama3.1:8b, ollama_chat/qwen2.5:7b, ollama_chat/llama3.2
MODELO=ollama_chat/llama3.1:8b

# Dirección del servidor de Ollama
OLLAMA_API_BASE=http://localhost:11434

# --- Alternativa: usar Gemini en lugar de Ollama ---
# MODELO=gemini/gemini-2.0-flash
# GEMINI_API_KEY=tu_clave_aca
